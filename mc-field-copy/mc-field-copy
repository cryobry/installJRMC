"""Copy missing custom field definitions between JRiver Media Center libraries via MCWS."""

import argparse
import base64
import getpass
import json
import re
import sys
import urllib.error
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET
from pathlib import Path

INTEGER = re.compile(r"^-?\d+$")
TYPES = ("string", "integer", "list", "date")
# MCWS DataType -> CreateField type; unlisted types (Decimal, Path, ...) become string.
SOURCE_TYPES = {"String": "string", "Integer": "integer", "List": "list",
                "Date (float)": "date", "Date": "integer"}
# Written by MPL export only; not a library field.
MPL_ONLY = {"date (readable)"}


def mpl_files(paths):
    for p in map(Path, paths):
        if p.is_dir():
            yield from sorted(f for f in p.rglob("*") if f.suffix.lower() == ".mpl")
        else:
            yield p


def scan(files):
    """Return {field name: set of observed values} across all MPL items."""
    fields = {}
    for f in files:
        for _, el in ET.iterparse(f):
            if el.tag == "Field" and el.get("Name"):
                fields.setdefault(el.get("Name"), set()).add(el.text or "")
            elif el.tag == "Item":
                el.clear()
    return fields


def infer_type(values):
    values = [v for v in values if v != ""]
    if any(";" in v and "\n" not in v for v in values):
        return "list"
    if values and all(INTEGER.match(v) for v in values):
        return "integer"
    return "string"


class MCWS:
    def __init__(self, url):
        parts = urllib.parse.urlsplit(url)
        if not parts.scheme or not parts.hostname:
            sys.exit(f"Invalid URL {url!r}; expected e.g. http://user@host:52199")
        user = urllib.parse.unquote(parts.username) if parts.username else None
        password = urllib.parse.unquote(parts.password) if parts.password is not None else None
        if user and password is None:
            password = getpass.getpass(f"MCWS password for {user}@{parts.hostname}: ")
        netloc = parts.netloc.rpartition("@")[2]
        self.base = urllib.parse.urlunsplit((parts.scheme, netloc, parts.path.rstrip("/"), "", "")) + "/MCWS/v1/"
        self.headers = {}
        if user:
            token = base64.b64encode(f"{user}:{password}".encode()).decode()
            self.headers["Authorization"] = f"Basic {token}"

    def call(self, command, **params):
        url = self.base + command
        if params:
            url += "?" + urllib.parse.urlencode(params, doseq=True)
        req = urllib.request.Request(url, headers=self.headers)
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                root = ET.fromstring(resp.read())
        except urllib.error.HTTPError as e:
            sys.exit(f"MCWS {command} failed: HTTP {e.code} {e.reason}")
        except urllib.error.URLError as e:
            sys.exit(f"Cannot reach {self.base}: {e.reason}")
        if root.get("Status") != "OK":
            sys.exit(f"MCWS {command} failed: {ET.tostring(root, encoding='unicode')}")
        return root

    def fields(self):
        return {f.get("Name", "").casefold(): f.attrib
                for f in self.call("Library/Fields").iter("Field")}


def load_fields(path):
    try:
        with Path(path).open(encoding="utf-8") as file:
            fields = json.load(file)
    except (OSError, ValueError) as error:
        sys.exit(f"Cannot read field snapshot {path!r}: {error}")
    if not isinstance(fields, list) or not all(
        isinstance(field, dict) and field.get("Name")
        and all(isinstance(value, str) for value in field.values())
        for field in fields
    ):
        sys.exit(f"Invalid field snapshot {path!r}: expected a list of named field definitions")
    return {field["Name"].casefold(): field for field in fields}


def save_fields(path, fields):
    attributes = ("Name", "DataType", "Type", "EditType", "Expression")
    snapshot = [{key: field[key] for key in attributes if key in field}
                for field in fields.values() if field.get("Name")]
    try:
        with path.open("x", encoding="utf-8") as file:
            json.dump(snapshot, file, ensure_ascii=False, indent=2)
            file.write("\n")
    except OSError as error:
        sys.exit(f"Cannot save field snapshot {str(path)!r}: {error}")
    print(f"Saved {len(snapshot)} field definitions to {path}")


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("-s", "--source", metavar="URL_OR_FILE",
                    help="source Library Server URL or saved JSON field snapshot")
    ap.add_argument("-t", "--target", metavar="URL_OR_FILE",
                    help="target Library Server URL or new JSON field snapshot")
    ap.add_argument("-m", "--mpl", action="extend", nargs="+", default=[], metavar="PATH",
                    help="fallback: take field names from MPL files or directories instead of all "
                         "source fields; types are inferred unless --source has them")
    ap.add_argument("-f", "--field", action="append", default=[], metavar="FIELD=TYPE",
                    help=f"add a missing field or override its type ({', '.join(TYPES)}); repeatable")
    ap.add_argument("-n", "--dry-run", action="store_true", help="only show what would be created")
    args = ap.parse_args()

    live_source = args.source and "://" in args.source
    if args.target is not None and "://" not in args.target:
        if not live_source:
            ap.error("a file --target requires a live --source URL")
        if args.mpl or args.field or args.dry_run:
            ap.error("a file --target cannot be combined with --mpl, --field, or --dry-run")
        save_fields(Path(args.target), MCWS(args.source).fields())
        return

    overrides = {}
    for spec in args.field:
        name, _, kind = spec.rpartition("=")
        if not name.strip() or kind.lower() not in TYPES:
            ap.error(f"invalid --field {spec!r}; expected FIELD=TYPE")
        overrides[name.casefold()] = (name, kind.lower())
    if not (args.mpl or args.source or overrides):
        ap.error("specify --source, --mpl, or --field")

    files = list(mpl_files(args.mpl))
    missing = [f for f in files if not f.is_file()]
    if missing:
        ap.error("not found: " + ", ".join(map(str, missing)))
    try:
        found = scan(files)
    except ET.ParseError as e:
        sys.exit(f"Invalid MPL: {e}")

    source = {}
    if args.source:
        source = MCWS(args.source).fields() if live_source else load_fields(args.source)
    mc = MCWS(args.target if args.target is not None else "http://localhost:52199")
    existing = mc.fields()
    if not args.mpl:
        # Internal fields like "Rich Data" are flagged User but not editable.
        found = {f["Name"]: set() for f in source.values()
                 if "User" in f.get("Type", "").split(";")
                 and f.get("EditType") != "Not editable"}

    found_keys = {name.casefold() for name in found}
    for key, (name, _) in overrides.items():
        if key not in found_keys:
            found[name] = set()

    new = []
    for name, values in sorted(found.items(), key=lambda kv: kv[0].casefold()):
        key = name.casefold()
        if key in existing or (key in MPL_ONLY and key not in overrides):
            continue
        src = source.get(key)
        if src:
            kind = SOURCE_TYPES.get(src.get("DataType", ""), "string")
            expression = src.get("Expression", "")
            flags = [flag for flag in src.get("Type", "").split(";")
                     if flag in {"SavedInTag", "DefaultSearchField"}]
            origin = f"source {src.get('DataType')}"
        else:
            kind, expression, origin = infer_type(values), "", "inferred"
            flags = []
        if key in overrides:
            kind, origin = overrides[key][1], "override"
        new.append((name, kind, expression, origin, flags))

    origins = []
    if args.mpl:
        origins.append(f"{len(files)} MPL file(s)")
    elif args.source:
        origins.append("source user fields")
    if overrides:
        origins.append("explicit fields")
    origin_desc = " + ".join(origins)
    print(f"{origin_desc}: {len(found)} field(s), "
          f"{len(found) - len(new)} existing or skipped, {len(new)} to create")
    for name, kind, expression, origin, flags in new:
        calc = f" = {expression}" if expression else ""
        print(f"{'would create' if args.dry_run else 'creating'}: {name} ({kind}, {origin}){calc}")
        if not args.dry_run:
            params = {"Name": name, "Type": [kind, *flags]}
            if expression:
                params["Expression"] = expression
            mc.call("Library/CreateField", **params)


if __name__ == "__main__":
    main()

